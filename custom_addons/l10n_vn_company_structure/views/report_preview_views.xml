        <field name="name">account.move.form.inherit.preview</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_preview_invoice"
                        type="object"
                        string="Xem Trước Hóa Đơn"
                        class="btn btn-secondary"
                        icon="fa-eye"
                        invisible="not id"
                        help="Mở xem trước bản in Hóa đơn trên tab mới của trình duyệt trước khi in"/>
            </xpath>
        </field>
    </record>

    <!-- 4. Phiếu Nhập Kho & Phiếu Xuất Kho TT200 -->
