<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Báo Giá & Đơn Bán Hàng -->
    <record id="view_order_form_inherit_preview" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.preview</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_preview_sale_order"
                        type="object"
                        string="Xem Trước Mẫu In"
                        class="btn btn-secondary"
                        icon="fa-eye"
                        invisible="not id"
                        help="Mở xem trước bản in Báo giá / Đơn hàng trên tab mới của trình duyệt trước khi in"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Đơn Mua Hàng -->
    <record id="purchase_order_form_inherit_preview" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.preview</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_preview_purchase_order"
                        type="object"
                        string="Xem Trước Mẫu In"
                        class="btn btn-secondary"
                        icon="fa-eye"
                        invisible="not id"
                        help="Mở xem trước bản in Đơn mua hàng trên tab mới của trình duyệt trước khi in"/>
            </xpath>
        </field>
    </record>

    <!-- 3. Hóa Đơn Khách Hàng / Hóa Đơn NCC -->
