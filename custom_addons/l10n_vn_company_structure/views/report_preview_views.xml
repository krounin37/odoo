        <field name="name">stock.picking.form.inherit.preview</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_preview_stock_voucher"
                        type="object"
                        string="Xem Trước Phiếu Kho"
                        class="btn btn-secondary"
                        icon="fa-eye"
                        invisible="not id"
                        help="Mở xem trước Phiếu nhập / xuất kho TT200 trên tab mới của trình duyệt trước khi in"/>
            </xpath>
        </field>
    </record>

    <!-- 5. Phiếu Thu & Phiếu Chi TT200 -->
    <record id="view_account_payment_form_inherit_preview" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.preview</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
