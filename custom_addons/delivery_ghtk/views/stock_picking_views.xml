<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_ghtk" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.ghtk</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- Nút in tem nhãn GHTK trên Header -->
            <xpath expr="//header" position="inside">
                <button name="action_ghtk_print_label"
                        type="object"
                        string="In Tem Nhãn GHTK"
                        class="btn-outline-primary"
                        icon="fa-barcode"
                        invisible="not carrier_tracking_ref or delivery_type != 'ghtk'"/>
            </xpath>

            <!-- Thêm thông tin COD và Vận đơn vào tab Additional Info hoặc cạnh carrier_id -->
            <xpath expr="//field[@name='carrier_tracking_ref']" position="after">
                <field name="ghtk_cod_amount" invisible="delivery_type != 'ghtk'"/>
                <field name="ghtk_print_label_url" widget="url" invisible="delivery_type != 'ghtk' or not ghtk_print_label_url"/>
            </xpath>
        </field>
    </record>
</odoo>
