<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_inherit_vietqr" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.vietqr</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_bic']" position="after">
                <field name="vietqr_bank_code" placeholder="VD: VCB, MB, TCB, CTG, ACB, VPB hoặc mã BIN..."/>
            </xpath>
        </field>
    </record>
</odoo>
