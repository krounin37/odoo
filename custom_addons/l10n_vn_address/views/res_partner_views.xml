<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_l10n_vn_address" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n.vn.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <!-- Tùy biến trường street với placeholder rõ ràng -->
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='street']" position="attributes">
                <attribute name="placeholder">Số nhà, ngõ/ngách, tên đường, tòa nhà...</attribute>
            </xpath>

            <!-- Ẩn street2 và zip khi quốc gia là Việt Nam để giữ form gọn gàng chuẩn hành chính VN -->
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='street2']" position="attributes">
                <attribute name="invisible">country_code == 'VN'</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='zip']" position="attributes">
                <attribute name="invisible">country_code == 'VN'</attribute>
            </xpath>

            <!-- Chèn Phường/Xã và Quận/Huyện trước Tỉnh/Thành phố -->
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='city']" position="attributes">
                <attribute name="invisible">country_code == 'VN'</attribute>
            </xpath>

            <xpath expr="//div[hasclass('o_address_format')]//field[@name='state_id']" position="before">
                <field name="ward_id" placeholder="Phường / Xã / Thị trấn" options="{'no_open': True, 'no_create_edit': True}"/>
                <field name="district_id" placeholder="Quận / Huyện / Thị xã" options="{'no_open': True, 'no_create_edit': True}"/>
            </xpath>

            <xpath expr="//div[hasclass('o_address_format')]//field[@name='state_id']" position="attributes">
                <attribute name="placeholder">Tỉnh / Thành phố</attribute>
            </xpath>

            <!-- Nút chuẩn hóa và chuyển đổi địa chỉ mô hình mới -->
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <div class="d-flex align-items-center gap-2 mt-1" invisible="not (district_id or ward_id or state_id)">
                    <button name="action_standardize_vn_address"
                            type="object"
                            string="Chuẩn hóa chuỗi địa chỉ"
                            icon="fa-map-marker"
                            class="btn btn-sm btn-link p-0 text-primary"
                            help="Tự động nối Số nhà/Đường + Phường/Xã + Tỉnh/Thành vào trường địa chỉ để xuất hóa đơn và giao hàng"/>
                    <button name="action_convert_legacy_to_new_address"
                            type="object"
                            string="Chuyển sang ĐVHC mới (2 cấp)"
                            icon="fa-refresh"
                            class="btn btn-sm btn-link p-0 text-success"
                            help="Tự động chuyển đổi địa chỉ cũ sang Phường/Xã &amp; Tỉnh/Thành mới theo Nghị quyết 202/2025/QH15 (dvhcvn)"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
