<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cash_payment_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: 'Times New Roman', Times, serif; font-size: 13px; line-height: 1.3;">
                    <!-- Header -->
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="width: 58%; vertical-align: top;">
                                <strong style="font-size: 13.5px;" t-esc="o.company_id.name.upper()"/><br/>
                                <span>Địa chỉ: <t t-esc="o.company_id.partner_id.contact_address or o.company_id.street or ''"/></span><br/>
                                <span t-if="o.company_id.vat">Mã số thuế: <strong t-esc="o.company_id.vat"/></span>
                            </td>
                            <td style="width: 42%; text-align: center; vertical-align: top;">
                                <strong>Mẫu số 02 - TT</strong><br/>
                                <span class="fst-italic" style="font-size: 11px;">(Ban hành theo Thông tư số 200/2014/TT-BTC<br/>ngày 22/12/2014 của Bộ Tài chính)</span>
                                <div class="text-start ps-3 mt-1" style="font-size: 12.5px;">
                                    <div>Số: <strong t-field="o.name"/></div>
                                    <div>Nợ: <span t-field="o.voucher_debit_account"/></div>
                                    <div>Có: <span t-field="o.voucher_credit_account"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Title -->
                    <div class="text-center mt-2 mb-2">
                        <h3 class="fw-bold mb-1" style="font-size: 22px; letter-spacing: 1px;">PHIẾU CHI</h3>
                        <div class="fst-italic" t-if="o.date">
                            Ngày <span t-esc="o.date.strftime('%d')"/> tháng <span t-esc="o.date.strftime('%m')"/> năm <span t-esc="o.date.strftime('%Y')"/>
                        </div>
                    </div>

                    <!-- Body Content -->
                    <div class="mt-2" style="font-size: 13px;">
                        <table style="width: 100%; border: none;">
                            <tr>
                                <td style="width: 25%; padding: 3px 0;">Họ và tên người nhận tiền:</td>
                                <td style="padding: 3px 0;"><strong t-esc="o.voucher_person_name or o.partner_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0;">Địa chỉ:</td>
                                <td style="padding: 3px 0;"><span t-esc="o.voucher_address or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0;">Lý do chi:</td>
                                <td style="padding: 3px 0;"><span t-esc="o.voucher_reason or o.memo or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0;">Số tiền:</td>
                                <td style="padding: 3px 0;"><strong t-field="o.amount"/> <strong t-field="o.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0;">Bằng chữ:</td>
                                <td style="padding: 3px 0;"><strong class="fst-italic" t-field="o.amount_words_vn"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0;">Kèm theo:</td>
                                <td style="padding: 3px 0;"><span t-esc="o.voucher_attached or '01'"/> chứng từ gốc.</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Signatures -->
                    <div class="mt-3" style="page-break-inside: avoid;">
                        <div class="text-end fst-italic" style="font-size: 12px; margin-bottom: 4px;" t-if="o.date">
                            Ngày <span t-esc="o.date.strftime('%d')"/> tháng <span t-esc="o.date.strftime('%m')"/> năm <span t-esc="o.date.strftime('%Y')"/>
                        </div>
                        <table style="width: 100%; text-align: center; border: none; font-size: 12px;">
                            <tr>
                                <td style="width: 20%; vertical-align: top;">
                                    <strong>Giám đốc</strong><br/>
                                    <span class="fst-italic" style="font-size: 11px;">(Ký, họ tên, đóng dấu)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top;">
                                    <strong>Kế toán trưởng</strong><br/>
                                    <span class="fst-italic" style="font-size: 11px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top;">
                                    <strong>Người nhận tiền</strong><br/>
                                    <span class="fst-italic" style="font-size: 11px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top;">
                                    <strong>Người lập phiếu</strong><br/>
                                    <span class="fst-italic" style="font-size: 11px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top;">
                                    <strong>Thủ quỹ</strong><br/>
                                    <span class="fst-italic" style="font-size: 11px;">(Ký, họ tên)</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-top: 55px; font-size: 12.5px; font-style: italic;">
                        <div>Đã nhận đủ số tiền (viết bằng chữ): ..........................................................................................................................</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
