<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cash_receipt_vn" model="ir.actions.report">
        <field name="name">In Phiếu Thu (Mẫu 01 - TT)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_cash_voucher.report_cash_receipt_template</field>
        <field name="report_file">l10n_vn_cash_voucher.report_cash_receipt_template</field>
        <field name="print_report_name">'Phieu_Thu_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_cash_payment_vn" model="ir.actions.report">
        <field name="name">In Phiếu Chi (Mẫu 02 - TT)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_cash_voucher.report_cash_payment_template</field>
        <field name="report_file">l10n_vn_cash_voucher.report_cash_payment_template</field>
        <field name="print_report_name">'Phieu_Chi_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
