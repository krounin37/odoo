<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cash_receipt_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article voucher-container" style="font-family: 'Times New Roman', Times, serif; font-size: 12.5px; line-height: 1.35; color: #000;">
                    <style>
                        .voucher-container table {
                            border: 0 !important;
                            border-collapse: collapse !important;
                        }
                        .voucher-container table tr,
                        .voucher-container table td,
                        .voucher-container table th {
                            border: 0 !important;
                            box-shadow: none !important;
                        }
                    </style>

                    <!-- Header chuẩn TT 200 -->
                    <table style="width: 100%; border: 0 !important; margin-bottom: 8px;">
                        <tr>
                            <td style="width: 58%; vertical-align: top; border: 0 !important; line-height: 1.35;">
                                <div><strong>Đơn vị: </strong><span style="font-size: 13px; font-weight: bold;" t-esc="o.company_id.name.upper()"/></div>
                                <div><strong>Địa chỉ: </strong><span t-esc="o.company_id.street or o.company_id.partner_id.contact_address or ''"/></div>
                                <div t-if="o.company_id.vat"><strong>Mã số thuế: </strong><span t-esc="o.company_id.vat"/></div>
                            </td>
                            <td style="width: 42%; text-align: center; vertical-align: top; border: 0 !important;">
                                <strong style="font-size: 13px;">Mẫu số 01 - TT</strong><br/>
                                <span class="fst-italic" style="font-size: 10.5px;">(Ban hành theo Thông tư số 200/2014/TT-BTC<br/>ngày 22/12/2014 của Bộ Tài chính)</span>
                                <table style="width: 100%; margin-top: 4px; font-size: 11.5px; border: 0 !important; text-align: left;">
                                    <tr>
                                        <td style="width: 25%; padding-left: 20px; border: 0 !important;">Số:</td>
                                        <td style="border: 0 !important;"><strong t-field="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px; border: 0 !important;">Nợ:</td>
                                        <td style="border: 0 !important;"><span t-field="o.voucher_debit_account"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px; border: 0 !important;">Có:</td>
                                        <td style="border: 0 !important;"><span t-field="o.voucher_credit_account"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Title -->
                    <div class="text-center mt-1 mb-2">
                        <h3 class="fw-bold mb-1" style="font-size: 21px; letter-spacing: 1.5px;">PHIẾU THU</h3>
                        <div class="fst-italic" style="font-size: 12px;" t-if="o.date">
                            Ngày <span t-esc="o.date.strftime('%d')"/> tháng <span t-esc="o.date.strftime('%m')"/> năm <span t-esc="o.date.strftime('%Y')"/>
                        </div>
                    </div>

                    <!-- Body Content (Không viền kẻ chuẩn TT200) -->
                    <div style="font-size: 12.5px; line-height: 1.5; margin-bottom: 8px;">
                        <div>- Họ và tên người nộp tiền: <strong t-esc="o.voucher_person_name or o.partner_id.name or ''"/></div>
                        <div>- Địa chỉ: <span t-esc="o.voucher_address or o.partner_id.contact_address or ''"/></div>
                        <div>- Lý do nộp: <span t-esc="o.voucher_reason or o.memo or 'Thu tiền khách hàng'"/></div>
                        <div>- Số tiền: <strong t-field="o.amount"/> <strong t-field="o.currency_id.name"/></div>
                        <div>- Bằng chữ: <strong class="fst-italic" t-field="o.amount_words_vn"/></div>
                        <div>- Kèm theo: <span t-esc="o.voucher_attached or '01'"/> chứng từ gốc.</div>
                    </div>

                    <!-- Signatures (KHÔNG CÓ ĐƯỜNG KẺ VIỀN) -->
                    <div class="mt-2" style="page-break-inside: avoid;">
                        <table style="width: 100%; border: 0 !important;">
                            <tr>
                                <td style="width: 80%; border: 0 !important;"></td>
                                <td style="width: 20%; text-align: center; font-style: italic; font-size: 11px; white-space: nowrap; border: 0 !important;">
                                    <t t-if="o.date">
                                        Ngày <span t-esc="o.date.strftime('%d')"/> tháng <span t-esc="o.date.strftime('%m')"/> năm <span t-esc="o.date.strftime('%Y')"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                        <table style="width: 100%; text-align: center; border: 0 !important; font-size: 11.5px; margin-top: 2px;">
                            <tr style="font-weight: bold;">
                                <td style="width: 20%; vertical-align: top; border: 0 !important;">
                                    <strong>Giám đốc</strong><br/>
                                    <span class="fst-italic" style="font-weight: normal; font-size: 10.5px;">(Ký, họ tên, đóng dấu)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top; border: 0 !important;">
                                    <strong>Kế toán trưởng</strong><br/>
                                    <span class="fst-italic" style="font-weight: normal; font-size: 10.5px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top; border: 0 !important;">
                                    <strong>Người nộp tiền</strong><br/>
                                    <span class="fst-italic" style="font-weight: normal; font-size: 10.5px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top; border: 0 !important;">
                                    <strong>Người lập phiếu</strong><br/>
                                    <span class="fst-italic" style="font-weight: normal; font-size: 10.5px;">(Ký, họ tên)</span>
                                </td>
                                <td style="width: 20%; vertical-align: top; border: 0 !important;">
                                    <strong>Thủ quỹ</strong><br/>
                                    <span class="fst-italic" style="font-weight: normal; font-size: 10.5px;">(Ký, họ tên)</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-top: 45px; font-size: 12px; font-style: italic;">
                        <div>Đã nhận đủ số tiền (viết bằng chữ): ..........................................................................................................................</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
