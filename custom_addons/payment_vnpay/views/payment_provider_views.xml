<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_inherit_vnpay" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.vnpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field name="vnpay_tmn_code"
                       invisible="code != 'vnpay'"
                       required="code == 'vnpay' and state != 'disabled'"
                       placeholder="Mã Terminal ID (ví dụ: DEMOVNPAY)"/>
                <field name="vnpay_hash_secret"
                       invisible="code != 'vnpay'"
                       required="code == 'vnpay' and state != 'disabled'"
                       widget="password"
                       placeholder="Chuỗi bí mật tạo chữ ký HMAC-SHA512"/>
                <field name="vnpay_version"
                       invisible="code != 'vnpay'"
                       groups="base.group_no_one"/>
            </group>
        </field>
    </record>
</odoo>
